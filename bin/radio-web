#!/usr/bin/env python3
"""radio-web — small web UI for the alarm radio (http://<hostname>.local/).

Reads/writes /etc/alarm-radio.conf, then runs radio-apply. Standard library only.
"""
import json
import re
import socket
import subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CONF = "/etc/alarm-radio.conf"
STATIONS = "/etc/alarm-radio-stations.txt"
PORT = 80
try:
    VERSION = open("/usr/local/share/alarm-radio/VERSION").read().strip()
except OSError:
    VERSION = "dev"
URL_RE = r"https?://[A-Za-z0-9._~:/?#\[\]@!&()*+,;=%-]+"
DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
NET = "/usr/local/bin/radio-net"
LOGO = "/usr/local/share/alarm-radio/logo.png"
NET_STATE = "/run/alarm-radio/net.json"
HOTSPOT_NET = "10.42.0."              # clients of the setup hotspot get addresses here


def run(*cmd, timeout=30):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout + p.stderr).strip()
    except subprocess.TimeoutExpired:
        return 1, "timeout"


def read_conf():
    conf = {}
    for line in open(CONF):
        m = re.match(r"^([A-Z_]+)=(\"[^\"]*\"|'[^']*'|\S*)", line)
        if m:
            conf[m.group(1)] = m.group(2).strip("\"'")
    return conf


def write_conf(updates):
    lines = open(CONF).read().splitlines(keepends=True)
    done = set()
    for i, line in enumerate(lines):
        m = re.match(r"^([A-Z_]+)=(\"[^\"]*\"|'[^']*'|\S*)(.*)$", line.rstrip("\n"))
        if m and m.group(1) in updates:
            lines[i] = f"{m.group(1)}={updates[m.group(1)]}{m.group(3)}\n"
            done.add(m.group(1))
    lines += [f"{k}={v}\n" for k, v in updates.items() if k not in done]
    with open(CONF, "w") as f:
        f.writelines(lines)


def parse_days(spec):
    """'Mon..Fri' / 'Sat,Sun' / '*' -> list of day names."""
    if spec in ("", "*"):
        return list(DAYS)
    out = []
    for part in spec.split(","):
        if ".." in part:
            a, b = part.split("..")
            out += DAYS[DAYS.index(a):DAYS.index(b) + 1]
        elif part in DAYS:
            out.append(part)
    return out


def days_spec(days):
    days = [d for d in DAYS if d in days]
    if len(days) == 7:
        return '"*"'
    if days == DAYS[:5]:
        return "Mon..Fri"
    return ",".join(days)


def active(unit):
    return run("systemctl", "is-active", unit)[1] == "active"


def read_stations():
    """Name|URL lines from STATIONS; # comments and bad lines are skipped."""
    out = []
    try:
        for line in open(STATIONS, encoding="utf-8"):
            name, sep, url = line.strip().partition("|")
            if sep and not name.startswith("#") and url.startswith(("http://", "https://")):
                out.append({"name": name.strip(), "url": url.strip()})
    except OSError:
        pass
    return out


def mpv_get(prop):
    return run("sh", "-c", f"echo '{{\"command\":[\"get_property\",\"{prop}\"]}}' | "
               "socat -t 2 - UNIX-CONNECT:/run/alarm-radio/mpv.sock", timeout=3)[1]


def status():
    c = read_conf()
    mac = c.get("SPEAKER_MAC", "")
    bt = mac and "Connected: yes" in run("bluetoothctl", "info", mac)[1]
    playing = next((m for m, u in [("alarm", "radio-alarm"), ("test", "radio-test"),
                                   ("radio", "radio-play")] if active(u)), None)
    nxt = run("systemctl", "show", "radio-alarm.timer", "-p", "NextElapseUSecRealtime", "--value")[1]
    live_vol = now_url = None
    if playing:
        m = re.search(r'"data":([0-9.]+)', mpv_get("volume"))
        live_vol = round(float(m.group(1))) if m else None
        m = re.search(r'"data":"([^"]*)"', mpv_get("path"))
        now_url = m.group(1) if m else None
    return {
        "enabled": c.get("ALARM_ENABLED") == "yes",
        "time": c.get("ALARM_TIME", "07:00"),
        "days": parse_days(c.get("ALARM_DAYS", "Mon..Fri")),
        "url": c.get("STREAM_URL", ""),
        "volume": int(c.get("VOLUME", 60)),
        "fade": int(c.get("FADE_SEC", 45)),
        "duration": int(c.get("DURATION_MIN", 60)),
        "speaker": c.get("SPEAKER_NAME", ""),
        "connected": bool(bt),
        "playing": playing,
        "live_volume": live_vol,
        "now_url": now_url,
        "next": nxt if c.get("ALARM_ENABLED") == "yes" else "",
        "stations": read_stations(),
        "timezone": c.get("TIMEZONE", ""),
        "timezone_set": c.get("TIMEZONE_SET") == "yes",
        "host": socket.gethostname(),
        "net": net_state(),
        "version": VERSION,
        "bulb": bool(c.get("BULB_MAC")),
        "speaker_mac": mac,
        "light": c.get("LIGHT_ENABLED") == "yes",
        "light_color": c.get("LIGHT_COLOR", "ffb060"),
        "light_bright": int(c.get("LIGHT_BRIGHT", 100)),
    }


def light_color(v):
    v = str(v).lstrip("#").lower()
    if not re.fullmatch(r"[0-9a-f]{6}", v):
        raise ValueError("light colour must be RRGGBB")
    return v


def save(d):
    if not re.fullmatch(r"([01]\d|2[0-3]):[0-5]\d", d.get("time", "")):
        raise ValueError("time must be HH:MM")
    days = [x for x in d.get("days", []) if x in DAYS]
    if not days:
        raise ValueError("pick at least one day")
    url = d.get("url", "").strip()
    if not re.fullmatch(URL_RE, url):
        raise ValueError("stream URL must be a plain http(s):// address")

    def num(key, lo, hi):
        v = int(d.get(key))
        if not lo <= v <= hi:
            raise ValueError(f"{key} must be {lo}-{hi}")
        return str(v)

    write_conf({
        "ALARM_ENABLED": "yes" if d.get("enabled") else "no",
        "ALARM_TIME": d["time"],
        "ALARM_DAYS": days_spec(days),
        "STREAM_URL": f"'{url}'",
        "VOLUME": num("volume", 0, 100),
        "FADE_SEC": num("fade", 0, 600),
        "DURATION_MIN": num("duration", 1, 240),
        "LIGHT_ENABLED": "yes" if d.get("light") else "no",
        "LIGHT_COLOR": light_color(d.get("light_color", "ffb060")),
        "LIGHT_BRIGHT": num("light_bright", 1, 100),
    })
    rc, out = run("/usr/local/bin/radio-apply", timeout=60)
    if rc:
        raise ValueError(out)
    return out


def net_state():
    try:
        return json.load(open(NET_STATE))
    except (OSError, ValueError):
        return {}


_TZ = []


def timezones():
    if not _TZ:
        _TZ.extend(run("timedatectl", "list-timezones")[1].split())
    return _TZ


def set_timezone(d):
    tz = str(d.get("tz", ""))
    if tz not in timezones():
        raise ValueError("unknown time zone")
    rc, out = run("timedatectl", "set-timezone", tz)
    if rc:
        raise ValueError(out)
    write_conf({"TIMEZONE": tz, "TIMEZONE_SET": "yes"})
    rc, out = run("/usr/local/bin/radio-apply", timeout=60)    # the alarm timer carries the zone
    if rc:
        raise ValueError(out)
    return f"time zone {tz}"


def wifi_connect(d):
    ssid, psk = str(d.get("ssid", "")), str(d.get("psk", ""))
    if not 1 <= len(ssid.encode()) <= 32 or "\n" in ssid:
        raise ValueError("network name must be 1-32 characters")
    if psk and not 8 <= len(psk) <= 63:
        raise ValueError("WiFi password must be 8-63 characters")
    cc = str(d.get("country", "")).upper()
    if cc:
        if not re.fullmatch(r"[A-Z]{2}", cc):
            raise ValueError("country must be two letters, e.g. EE")
        run(NET, "country", cc)
    # runs on its own (the hotspot, and with it this connection, goes away while it works)
    run("systemctl", "stop", "radio-net-connect.service")
    rc, out = run("systemd-run", "--quiet", "--collect", "--unit=radio-net-connect", NET, "connect", ssid, psk)
    if rc:
        raise ValueError(out)
    return f"connecting to {ssid}"


BULB = "/usr/local/bin/bulb"
MAC_RE = r"([0-9A-F]{2}:){5}[0-9A-F]{2}"


def bt_scan():
    """Scan ~12 s, return nearby audio output devices (speakers/headphones) plus already paired ones."""
    run("bluetoothctl", "--timeout", "12", "scan", "on", timeout=25)
    current = read_conf().get("SPEAKER_MAC", "")
    out = []
    for line in run("bluetoothctl", "devices")[1].splitlines():
        parts = line.split(" ", 2)
        if len(parts) < 3 or not re.fullmatch(MAC_RE, parts[1]):
            continue
        mac, info = parts[1], run("bluetoothctl", "info", parts[1], timeout=5)[1]
        audio = "Audio Sink" in info or re.search(r"Icon: audio-(card|headset|headphones|speaker)", info)
        name = (re.search(r"^\s*Alias: (.*)$", info, re.M) or re.search(r"^\s*Name: (.*)$", info, re.M))
        name = name.group(1).strip() if name else ""
        if not audio or not name or name.replace("-", ":") == mac:
            continue
        rssi = re.search(r"RSSI: \S+ \((-?\d+)\)", info)
        out.append({"mac": mac, "name": name, "paired": "Bonded: yes" in info,
                    "connected": "Connected: yes" in info, "current": mac == current,
                    "rssi": int(rssi.group(1)) if rssi else None})
    out.sort(key=lambda d: (not d["current"], not d["paired"], -(d["rssi"] or -999)))
    return out


def bt_use(d):
    mac = str(d.get("mac", "")).upper()
    if not re.fullmatch(MAC_RE, mac):
        raise ValueError("bad Bluetooth address")
    rc, out = run("/usr/local/bin/radio-pair", mac, timeout=150)
    if rc:
        raise ValueError(out.splitlines()[-1] if out else "pairing failed")
    return out


def bulb(d):
    """{action: on|off|white|rgb, rgb: 'RRGGBB', bright: 0-100}"""
    act = d.get("action")
    bright = str(max(0, min(100, int(d.get("bright", 100)))))
    if act in ("on", "off"):
        args = [act]
    elif act == "white":
        args = ["white", bright]
    elif act == "rgb":
        rgb = str(d.get("rgb", "")).lstrip("#")
        if not re.fullmatch(r"[0-9A-Fa-f]{6}", rgb):
            raise ValueError("colour must be RRGGBB")
        args = ["rgb", rgb, bright]
    else:
        raise ValueError("unknown bulb action")
    rc, out = run(BULB, *args, timeout=60)
    if rc:
        raise ValueError(out)
    return out


ACTIONS = {
    "stop": ["/usr/local/bin/radio", "stop"],
    "test": ["/usr/local/bin/radio", "test-alarm"],
}


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, body, ctype="application/json"):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def via_hotspot(self):
        return self.client_address[0].startswith(HOTSPOT_NET)

    def do_GET(self):
        if self.path == "/api/status":
            self.send(200, json.dumps(status()))
        elif self.path == "/api/wifi/scan":
            self.send(200, run(NET, "scan", timeout=60)[1] or "[]")
        elif self.path == "/api/net":
            self.send(200, run(NET, "status", timeout=20)[1] or "{}")
        elif self.path == "/api/timezones":
            self.send(200, json.dumps(timezones()))
        elif self.via_hotspot() and not self.path.startswith("/api/"):
            # captive portal: phones on the setup hotspot get the WiFi setup page for any URL
            self.send(200, SETUP_PAGE, "text/html; charset=utf-8")
        elif self.path == "/api/bt/scan":
            self.send(200, json.dumps({"devices": bt_scan()}))
        elif self.path == "/api/bulb":
            # reads the bulb over Bluetooth (~2 s), so the page asks only on load
            rc, out = run(BULB, "status", timeout=40)
            self.send(200, out if rc == 0 else json.dumps({"error": out}))
        elif self.path == "/logo.png":
            try:
                self.send(200, open(LOGO, "rb").read(), "image/png")
            except OSError:
                self.send(404, "{}")
        elif self.path in ("/", "/index.html"):
            self.send(200, PAGE, "text/html; charset=utf-8")
        else:
            self.send(404, "{}")

    def do_POST(self):
        try:
            n = int(self.headers.get("Content-Length", 0))
            d = json.loads(self.rfile.read(n) or b"{}")
            if self.path == "/api/save":
                msg = save(d)
            elif self.path == "/api/play":
                # plays the given URL (e.g. the station picked in the UI) without saving it
                url = (d.get("url") or "").strip()
                if url and not re.fullmatch(URL_RE, url):
                    raise ValueError("stream URL must be a plain http(s):// address")
                msg = run("/usr/local/bin/radio", "play", *([url] if url else []))[1]
            elif self.path == "/api/vol":
                v = int(d.get("volume"))
                msg = run("/usr/local/bin/radio", "vol", str(max(0, min(100, v))))[1]
            elif self.path == "/api/bulb":
                msg = bulb(d)
            elif self.path == "/api/bt/use":
                msg = bt_use(d)
            elif self.path == "/api/wifi/connect":
                msg = wifi_connect(d)
                return self.send(200, json.dumps({"ok": True, "msg": msg}))
            elif self.path == "/api/wifi/hotspot":
                run("systemd-run", "--quiet", "--collect", "--unit=radio-net-hotspot", NET, "hotspot")
                return self.send(200, json.dumps({"ok": True, "msg": "setup hotspot starting"}))
            elif self.path == "/api/timezone":
                msg = set_timezone(d)
            elif self.path.startswith("/api/") and self.path[5:] in ACTIONS:
                msg = run(*ACTIONS[self.path[5:]])[1]
            else:
                return self.send(404, "{}")
            self.send(200, json.dumps({"ok": True, "msg": msg, "status": status()}))
        except (ValueError, TypeError, KeyError) as e:
            self.send(400, json.dumps({"ok": False, "msg": str(e)}))


