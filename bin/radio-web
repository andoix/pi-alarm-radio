}
const bsend=()=>bmode==="white"?bulb({action:"white",bright:+$("bbright").value},"White "+$("bbright").value+" %")
  :bulb({action:"rgb",rgb:$("bcolor").value.slice(1),bright:+$("bbright").value},"Colour "+$("bbright").value+" %");
$("bon").onclick=()=>bulb({action:"on"},"On");
$("boff").onclick=()=>bulb({action:"off"},"Off");
$("bwhite").onclick=()=>{bmode="white";bsend()};
$("bcolor").addEventListener("change",()=>{bmode="rgb";bsend()});
$("bbright").addEventListener("change",bsend);
function loadBulb(){api("bulb").then(s=>{
  if(s.error){$("bulbst").textContent="not reachable";return}
  const sv=s.saved||{};bmode=sv.mode||"rgb";
  if(sv.rgb)$("bcolor").value="#"+sv.rgb;
  if(sv.bright)$("bbright").value=sv.bright;bbr();
  $("bulbst").textContent=s.on?(s.w&&!(s.r||s.g||s.b)?"White":"#"+hex(s.r)+hex(s.g)+hex(s.b)):"Off";
}).catch(()=>{$("bulbst").textContent="not reachable"})}

// --- Speaker (Bluetooth) ---
const esc=t=>String(t).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function btmsg(t,ok){$("btmsg").textContent=t;$("btmsg").style.color=ok===false?"var(--bad)":ok?"var(--ok)":""}
$("btscan").onclick=async()=>{
  $("btscan").disabled=true;$("btlist").innerHTML="";btmsg("Scanning for about 15 seconds…");
  try{
    const r=await api("bt/scan");
    $("btlist").innerHTML=r.devices.map(d=>`<div class="dev"><div><b>${esc(d.name)}</b>
      <span class="st">${d.current?"in use":d.paired?"paired":"new"}${d.rssi!=null?" · signal "+d.rssi+" dBm":""}</span></div>
      ${d.current?"":`<button data-mac="${esc(d.mac)}" data-name="${esc(d.name)}">Use</button>`}</div>`).join("");
    btmsg(r.devices.length?"":"No speakers found. Is it on and in pairing mode?",r.devices.length?null:false);
    document.querySelectorAll("#btlist button").forEach(b=>b.onclick=()=>useSpeaker(b.dataset.mac,b.dataset.name));
  }catch(e){btmsg("Scan failed",false)}
  $("btscan").disabled=false;
};
async function useSpeaker(mac,name){
  if(!confirm("Switch the radio to "+name+"?"))return;
  document.querySelectorAll("#btlist button,#btscan").forEach(b=>b.disabled=true);
  btmsg("Connecting to "+name+"… (up to a minute)");
  try{const r=await api("bt/use",{mac});
      if(r.ok){btmsg("Audio now goes to "+name,true);$("btlist").innerHTML="";bulbLoaded=false;show(r.status,true)}
      else btmsg(r.msg,false)}
  catch(e){btmsg("No reply from the radio",false)}
  document.querySelectorAll("#btlist button,#btscan").forEach(b=>b.disabled=false);
}
</script></body></html>
