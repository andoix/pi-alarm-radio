<script>
const $=id=>document.getElementById(id), D=["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
$("days").innerHTML=D.map(d=>`<label><input type="checkbox" value="${d}"><span>${d}</span></label>`).join("");
const fmt={lbrv:()=>$("light_bright").value+" %",volv:()=>$("volume").value,fadev:()=>$("fade").value+" s",durv:()=>$("duration").value+" min",livev:()=>$("live").value};
const upd=()=>{for(const k in fmt)$(k).textContent=fmt[k]();$("alarmfields").classList.toggle("off",!$("enabled").checked);$("lightfields").classList.toggle("off",!$("light").checked)};
["volume","fade","duration","live","enabled","light","light_bright"].forEach(i=>$(i).addEventListener("input",upd));

function stations(list,url){
  const sel=$("station");
  if(sel.options.length!==list.length+1)
    sel.innerHTML=list.map(x=>`<option value="${x.url}">${x.name}</option>`).join("")+`<option value="">Other (enter URL)</option>`;
  sel.value=list.some(x=>x.url===url)?url:"";
}
$("station").addEventListener("change",()=>{if($("station").value)$("url").value=$("station").value;else $("url").focus()});
$("url").addEventListener("input",()=>stations([...$("station").options].filter(o=>o.value).map(o=>({name:o.text,url:o.value})),$("url").value.trim()));
function show(s,form){
  if(form){
    stations(s.stations,s.url);
    $("enabled").checked=s.enabled;$("time").value=s.time;$("url").value=s.url;
    $("volume").value=s.volume;$("fade").value=s.fade;$("duration").value=s.duration;
    document.querySelectorAll("#days input").forEach(c=>c.checked=s.days.includes(c.value));
    $("light").checked=s.light;$("light_color").value="#"+s.light_color;$("light_bright").value=s.light_bright;
  }
  $("wakebox").style.display=s.bulb?"":"none";
  $("lightcard").style.display=s.bulb?"":"none";
  if(s.bulb&&!bulbLoaded){bulbLoaded=true;loadBulb()}
  $("spkname").textContent=s.speaker||"none";
  $("ver").textContent="PiAlarmRadio "+(s.version||"");
  $("welcome").style.display=!s.timezone_set?"":"none";
  const n=s.net||{};
  $("netinfo").textContent=n.mode==="client"?`Connected to ${n.ssid}${n.ip?" ("+n.ip+")":""} · http://${s.host}.local`:n.mode==="ap"?"Setup hotspot is on":"—";
  if(form)loadTz(s);
  $("next").textContent=s.enabled&&s.next?"Next alarm: "+s.next:"Alarm is off";
  $("speaker").innerHTML=`<span class="dot" style="background:var(--${s.connected?"ok":"bad"})"></span>${s.speaker} ${s.connected?"connected":"not connected"}`;
  const st=(s.stations||[]).find(x=>x.url===s.now_url);
  $("playing").textContent=s.playing?"Playing: "+(s.playing==="radio"?(st?st.name:"radio"):s.playing+(st?" · "+st.name:"")):"Idle";
  $("livebox").style.display=s.playing?"":"none";
  if(s.live_volume!=null&&document.activeElement!==$("live"))$("live").value=s.live_volume;
  upd();
}
async function api(path,body){
  const r=await fetch("/api/"+path,body?{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)}:{});
  return r.json();
}
async function refresh(form){try{show(await api("status"),form)}catch(e){}}
function msg(t,ok){$("msg").textContent=t;$("msg").style.color=ok?"var(--ok)":"var(--bad)"}

$("save").onclick=async()=>{
  const body={enabled:$("enabled").checked,time:$("time").value,url:$("url").value.trim(),
    volume:+$("volume").value,fade:+$("fade").value,duration:+$("duration").value,
    light:$("light").checked,light_color:$("light_color").value.slice(1),light_bright:+$("light_bright").value,
    days:[...document.querySelectorAll("#days input:checked")].map(c=>c.value)};
  $("save").disabled=true;msg("Saving…",true);
  try{const r=await api("save",body);msg(r.ok?"Saved.":r.msg,r.ok);if(r.ok)show(r.status,true)}
  catch(e){msg("Could not reach the radio",false)}
  $("save").disabled=false;
};
document.querySelectorAll("[data-a]").forEach(b=>b.onclick=async()=>{
  b.disabled=true;
  try{const r=await api(b.dataset.a,b.dataset.a==="play"?{url:$("url").value.trim()}:{});
      if(r.ok===false)msg(r.msg,false);else show(r.status,false)}catch(e){}
  b.disabled=false;
});
$("live").addEventListener("change",()=>api("vol",{volume:+$("live").value}));
refresh(true);setInterval(()=>refresh(false),5000);

// --- time zone ---
let tzList=null;
async function loadTz(s){
  if(!tzList)tzList=await api("timezones");
  const guess=Intl.DateTimeFormat().resolvedOptions().timeZone;
  const opts=tzList.map(z=>`<option>${z}</option>`).join("");
  $("tz").innerHTML=opts;$("wtz").innerHTML=opts;
  $("tz").value=s.timezone;
  $("wtz").value=tzList.includes(guess)?guess:s.timezone;   // welcome: suggest the phone's zone
}
async function saveTz(sel){
  const r=await api("timezone",{tz:sel.value});
  $("tzmsg").textContent=r.ok?"Saved: "+sel.value:r.msg;$("tzmsg").style.color=r.ok?"var(--ok)":"var(--bad)";
  if(r.ok)show(r.status,true);
}
$("tzsave").onclick=()=>saveTz($("tz"));
$("wtzsave").onclick=()=>saveTz($("wtz"));
$("wchange").onclick=()=>{$("wform").style.display="";$("wchange").style.display="none";wifiInit(false)};

// --- WiFi form (setup page and Settings) ---
const escw=t=>String(t).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
async function wifiInit(setup){
  try{const n=await (await fetch("/api/net")).json();if(n.country)$("wcc").value=n.country;
      if(setup&&n.result&&n.result.state==="failed")wmsg("Could not connect to "+n.result.ssid+": "+n.result.msg,false)}catch(e){}
  try{
    const nets=await (await fetch("/api/wifi/scan")).json();
    $("wnets").innerHTML=nets.length?nets.map(n=>`<div class="dev"><div><b>${escw(n.ssid)}</b><span class="st">${n.secure?"🔒 ":""}signal ${n.signal} %</span></div><button data-ssid="${escw(n.ssid)}">Choose</button></div>`).join(""):"No networks found. Type the name below (hidden networks too).";
    document.querySelectorAll("#wnets button").forEach(b=>b.onclick=()=>{$("wssid").value=b.dataset.ssid;$("wpsk").focus()});
  }catch(e){$("wnets").textContent="Could not search for networks."}
  if(!setup)$("whot").style.display="";
}
function wmsg(t,ok){$("wmsg").textContent=t;$("wmsg").style.color=ok===false?"var(--bad)":ok?"var(--ok)":""}
$("wgo").onclick=async()=>{
  const ssid=$("wssid").value.trim(),psk=$("wpsk").value,cc=$("wcc").value.trim().toUpperCase();
  if(!ssid)return wmsg("Choose or type a network name.",false);
  $("wgo").disabled=true;
  try{
    const r=await (await fetch("/api/wifi/connect",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({ssid,psk,country:cc})})).json();
    if(!r.ok){wmsg(r.msg,false);$("wgo").disabled=false;return}
    wmsg(`Connecting to ${ssid}… This connection will now drop. Connect your phone to "${ssid}" and open http://${location.hostname.match(/^\d/)?"alarmradio":location.hostname.split(".")[0]}.local — if it didn't work, the "PiAlarmRadio-Setup" network comes back within a minute: join it again to see what went wrong.`,true);
  }catch(e){wmsg("No reply — the radio may already be switching networks.",null)}
};
$("whot").onclick=async()=>{if(!confirm("Disconnect from WiFi and open the PiAlarmRadio-Setup hotspot?"))return;
  await fetch("/api/wifi/hotspot",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});
  wmsg('Hotspot starting. Join "PiAlarmRadio-Setup" with your phone.',true)};


// --- Light (Bluetooth bulb) ---
let bmode="rgb", bulbLoaded=false;
const bbr=()=>{$("bbrv").textContent=$("bbright").value+" %"};
$("bbright").addEventListener("input",bbr);bbr();
const hex=n=>n.toString(16).padStart(2,"0");
async function bulb(body,label){
  $("bulbst").textContent="…";
  try{const r=await api("bulb",body);$("bulbst").textContent=r.ok?label:r.msg;$("bulbst").style.color=r.ok?"":"var(--bad)"}
  catch(e){$("bulbst").textContent="no reply"}
}
const bsend=()=>bmode==="white"?bulb({action:"white",bright:+$("bbright").value},"White "+$("bbright").value+" %")
  :bulb({action:"rgb",rgb:$("bcolor").value.slice(1),bright:+$("bbright").value},"Colour "+$("bbright").value+" %");
$("bon").onclick=()=>bulb({action:"on"},"On");
$("boff").onclick=()=>bulb({action:"off"},"Off");
$("bwhite").onclick=()=>{bmode="white";bsend()};
$("bcolor").addEventListener("change",()=>{bmode="rgb";bsend()});
$("bbright").addEventListener("change",bsend);
function loadBulb(){api("bulb").then(s=>{
  if(s.error){$("bulbst").textContent="not reachable";return}
  const sv=s.saved||{};bmode=sv.mode||"rgb";
  if(sv.rgb)$("bcolor").value="#"+sv.rgb;
  if(sv.bright)$("bbright").value=sv.bright;bbr();
  $("bulbst").textContent=s.on?(s.w&&!(s.r||s.g||s.b)?"White":"#"+hex(s.r)+hex(s.g)+hex(s.b)):"Off";
}).catch(()=>{$("bulbst").textContent="not reachable"})}

// --- Speaker (Bluetooth) ---
const esc=t=>String(t).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function btmsg(t,ok){$("btmsg").textContent=t;$("btmsg").style.color=ok===false?"var(--bad)":ok?"var(--ok)":""}
$("btscan").onclick=async()=>{
  $("btscan").disabled=true;$("btlist").innerHTML="";btmsg("Scanning for about 15 seconds…");
  try{
    const r=await api("bt/scan");
    $("btlist").innerHTML=r.devices.map(d=>`<div class="dev"><div><b>${esc(d.name)}</b>
      <span class="st">${d.current?"in use":d.paired?"paired":"new"}${d.rssi!=null?" · signal "+d.rssi+" dBm":""}</span></div>
      ${d.current?"":`<button data-mac="${esc(d.mac)}" data-name="${esc(d.name)}">Use</button>`}</div>`).join("");
    btmsg(r.devices.length?"":"No speakers found. Is it on and in pairing mode?",r.devices.length?null:false);
    document.querySelectorAll("#btlist button").forEach(b=>b.onclick=()=>useSpeaker(b.dataset.mac,b.dataset.name));
  }catch(e){btmsg("Scan failed",false)}
  $("btscan").disabled=false;
};
async function useSpeaker(mac,name){
  if(!confirm("Switch the radio to "+name+"?"))return;
  document.querySelectorAll("#btlist button,#btscan").forEach(b=>b.disabled=true);
  btmsg("Connecting to "+name+"… (up to a minute)");
  try{const r=await api("bt/use",{mac});
      if(r.ok){btmsg("Audio now goes to "+name,true);$("btlist").innerHTML="";bulbLoaded=false;show(r.status,true)}
      else btmsg(r.msg,false)}
  catch(e){btmsg("No reply from the radio",false)}
  document.querySelectorAll("#btlist button,#btscan").forEach(b=>b.disabled=false);
}
</script></body></html>
